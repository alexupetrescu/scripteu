# Copy to /etc/scripteu.env, fill in, then:  chmod 640, chown root:<service-group>
#
# Read two ways: by systemd (EnvironmentFile) and by a shell sourcing it. So
# keep every value free of shell metacharacters -- ( ) & ; | # $ ` space -- or
# single-quote it. The generator below produces values that need no quoting.

# --- Django ---------------------------------------------------------------
ESC_DEBUG=0
# Generate with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
# NOT with Django's get_random_secret_key(): its alphabet includes ) & # $ ^ *,
# and this file is both sourced by a shell and read by systemd. A URL-safe
# token is only [A-Za-z0-9_-], which neither can misread.
ESC_SECRET_KEY=CHANGE_ME
ESC_ALLOWED_HOSTS=avestudio.ro,www.avestudio.ro
ESC_CSRF_TRUSTED_ORIGINS=https://avestudio.ro,https://www.avestudio.ro

# Served under a path prefix; nginx strips it before gunicorn sees the request.
ESC_SCRIPT_NAME=/scripteu
ESC_STATIC_ROOT=/srv/scripteu/staticfiles

# --- Background work ------------------------------------------------------
# Outside runserver the app starts nothing on its own. This opts the gunicorn
# worker in to the interrupted-run reaper and the session heartbeat, and is
# only safe with exactly ONE worker (see the systemd unit).
ESC_START_BACKGROUND=1
ESC_HEARTBEAT_ENABLED=1
ESC_HEARTBEAT_INTERVAL=900

# --- Browser --------------------------------------------------------------
ESC_HEADLESS=1
# No Chrome/Edge on a server: empty means Playwright's bundled Chromium.
ESC_BROWSER_CHANNEL=
# Almost always needed on a VPS. Without the first, Chromium cannot create its
# sandbox under a service account; without the second, a small /dev/shm makes
# it die in ways that look like a timeout.
ESC_BROWSER_ARGS=--no-sandbox,--disable-dev-shm-usage
PLAYWRIGHT_BROWSERS_PATH=/srv/scripteu/.playwright

# --- The EU Login browser, shown in the Settings page ---------------------
# The sign-in happens in a browser on THIS machine (the cookies have to end up
# here), displayed to you through noVNC. This is the screen it opens on.
DISPLAY=:99
ESC_VNC_ENABLED=1
# noVNC's client page, served by websockify behind nginx. "path" is where the
# WebSocket lives, relative to the domain root -- no leading slash.
# Single-quoted: unquoted, the '&' would background the assignment when a
# shell sources this file, leaving the variable unset.
ESC_VNC_URL='vnc.html?path=scripteu/vnc/websockify&autoconnect=1&resize=scale&reconnect=1'

# --- Paths ----------------------------------------------------------------
# Outside the git checkout, so a deploy is just `git pull`, and in a 0700
# directory because the outreach history is personal data.
ESC_DB_PATH=/srv/scripteu/state/db.sqlite3

# Both hold live portal credentials. Keep them off any web-served directory.
ESC_STORAGE_STATE=/srv/scripteu/state/storage_state.json
ESC_BROWSER_PROFILE=/srv/scripteu/state/browser_profile
ESC_RECON_DIR=/srv/scripteu/state/recon

# Chromium and Playwright both want a writable HOME.
HOME=/srv/scripteu
